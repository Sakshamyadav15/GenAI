# Copy to .env and fill in. Never commit .env.

# --- LLM provider (required for ingestion embeddings and answering) ---
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint (e.g. Azure/OpenAI proxy). Leave empty for api.openai.com
OPENAI_BASE_URL=

# Model IDs. Baseline and proposed pipelines always share these.
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# --- Storage ---
# Defaults to SQLite at backend/data/app.db when unset.
# PostgreSQL example: postgresql+asyncpg://rag:rag@localhost:5432/rag
DATABASE_URL=
# DATA_DIR=backend/data
# CHROMA_DIR=
# UPLOAD_DIR=

# Optional YAML file overriding research parameters (chunking, top-k, prices, ...)
# PIPELINE_CONFIG_PATH=

# --- API ---
LOG_LEVEL=INFO
DEFAULT_CORPUS=default
MAX_UPLOAD_MB=25
# JSON list
CORS_ORIGINS=["http://localhost:5173"]

# Replay saved real runs of the bundled demo questions (see docs/approach.md). Set false to always run live.
# DEMO_CACHE_ENABLED=true

# --- Indian-Acts instance (see docs/legal_acts_mode.md; normally set by backend/run_legal.ps1) ---
# EMBEDDING_PROVIDER=local            # openai (default) or local = free sentence-transformers embeddings
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# INSTANCE_MODE=legal_acts            # general (default) or legal_acts (UI wording only)
# LEGAL_BUDGET_MODE=true              # default pipeline = low-cost preset with a USD 0.001 per-question ceiling
# DEMO_QUESTIONS_PATH=                # sample-questions file (default backend/seed/demo_questions.json)
# DEMO_CACHE_DIR=                     # saved-sample directory (default backend/seed/demo_cache)
# LLM_PROVIDER=openai                # openai (default), gemini, or auto (Gemini when GEMINI_API_KEY is set)
# GEMINI_API_KEY=                     # free tier: about 20 requests/day and a few per minute PER MODEL
# GEMINI_MODEL=gemini-2.5-flash-lite
